# ============================================================
# KIA 티켓봇 설정 파일 템플릿
# 이 파일을 복사해 .env 로 만든 뒤 실제 값을 입력하세요.
# .env 파일은 절대 git에 커밋하지 마세요!
# ============================================================

# ------------------------------------------------------------
# 대상 티켓 정보
# GOODS_ID: 티켓 상품 페이지 URL에서 확인 (예: ticket.interpark.com/goods/12345678)
# SALE_START_TIME: 티켓 오픈 시각 (KST, ISO 8601 형식)
# ------------------------------------------------------------
GOODS_ID=12345678
SALE_START_TIME=2026-04-01T10:00:00+09:00

# ------------------------------------------------------------
# 좌석 우선순위 (잠실야구장 기준, 쉼표로 구분)
# 1순위: 112, 113구역 (중앙 테이블석)
# 2순위: 318, 319구역 (중앙 네이비석)
# 3순위: KIA 응원석 (3루 방향) 순차
# ------------------------------------------------------------
PREFERRED_SECTIONS=112,113,318,319,KIA_3루
MAX_TICKETS=3

# ------------------------------------------------------------
# Telegram 알림 설정
# BotFather에서 봇 생성 후 토큰 발급, chat_id는 @userinfobot 으로 확인
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# 동작 설정
# HEADLESS=false 권장 (실제 구매 시 브라우저 화면 표시)
# PRE_SALE_ACTIVATE_SECONDS: 오픈 몇 초 전에 브라우저를 상품 페이지로 이동할지
# ------------------------------------------------------------
POLLING_INTERVAL_SECONDS=0.5
PRE_SALE_ACTIVATE_SECONDS=30
HEADLESS=false
SCREENSHOT_ON_ERROR=true

# ------------------------------------------------------------
# 테스트 모드
# STOP_BEFORE_PAYMENT=true 로 설정하면 결제 직전에서 일시 정지합니다.
# 터미널에서 Enter(결제 진행) 또는 n(중단)을 입력해 제어할 수 있습니다.
# 선택자 검증, 플로우 확인 등 테스트 시에만 true로 설정하세요.
# ------------------------------------------------------------
STOP_BEFORE_PAYMENT=false

# ------------------------------------------------------------
# 스포츠 티켓 설정 (선택사항)
# 스포츠 경기 티켓인 경우 아래 두 값을 모두 설정하세요.
# 설정하지 않으면 일반 공연/콘서트 플로우를 사용합니다.
# SportsCode/TeamCode는 팀 페이지 URL에서 확인:
#   ticket.interpark.com/Contents/Sports/GoodsInfo?SportsCode=07002&TeamCode=PS113
# GOODS_ID는 DevTools Network 탭에서 goodsCode= 값으로 확인합니다.
# ------------------------------------------------------------
# SPORTS_CODE=07002
# TEAM_CODE=PS113

# ------------------------------------------------------------
# 스포츠 예매 상세 설정 (스포츠 모드 사용 시)
# ------------------------------------------------------------
# TICKET_ADULT=2
# TICKET_CHILD=1
# BOOKER_BIRTH=YYMMDD
# BOOKER_PHONE=010-0000-0000
# BOOKER_EMAIL=your@email.com
